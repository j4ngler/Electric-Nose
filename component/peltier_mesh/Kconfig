        int "Router Wi-Fi channel"
        range 1 13
        default 6

    config PELTIER_MESH_PASSWORD
        string "Mesh AP password (8 to 63 characters)"
        default ""

    config PELTIER_MESH_PEER
        string "Peer Wi-Fi STA MAC (aa:bb:cc:dd:ee:ff)"
        default ""
endif
